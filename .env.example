# Copy to `.env.local` and fill in secrets. Do not commit `.env.local`.

# UI shell: workspace (V2 landing + app, default) | classic (legacy marketing home).
# Override at runtime with ?ui=workspace|classic or localStorage poju.uiShell.
NEXT_PUBLIC_UI_SHELL=workspace
# Phase-4 delivery renderer: v2 (default) | legacy | debug (raw full_text mirror)
# NEXT_PUBLIC_DELIVERY_RENDER=legacy

GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_API_KEY=
GOOGLE_GENERATIVE_AI_MODEL=gemini-3.1-flash-lite-preview

# POJU v5 — OpenRouter (DeepSeek V4 Pro via OpenRouter)
OPENROUTER_API_KEY=
# GA slug（0813）. Undated deepseek/deepseek-v4-pro may still resolve to 0423.
OPENROUTER_MODEL=deepseek/deepseek-v4-pro-0813

# Provider order — StreamLake primary (prefix cache). Production may list only streamlake.
OPENROUTER_PROVIDER_ORDER=streamlake
# Phase-4 delivery escape (queue/midstream attempt 2): DigitalOcean. Default = digitalocean if unset.
OPENROUTER_PROVIDER_ESCAPE=digitalocean

# Phase-4 page fill shape anchor: skeleton (zero-narrative) | mock (legacy few-shot).
# Default = mock until Gate 0 grayscale proves skeleton structural failure rate is safe.
# Then set skeleton (and later flip code default). Rollback: DELIVERY_FILL_SHAPE_MODE=mock
# DELIVERY_FILL_SHAPE_MODE=skeleton

# Production final-delivery is v3 when this is unset (judgment → body → gate → polish → evidence_soft).
# Explicit rollback of live jobs only: DELIVERY_PIPELINE=legacy (assign/write/fill DAG).
# Lab session create still defaults to legacy unless this is v3_three_step.
# DELIVERY_PIPELINE=legacy

# Phase 4 evidence mark: combined (default) | split (foreign: translate then mark)
# DELIVERY_MARK_MODE=combined

# Upstash / Vercel KV ? required on Vercel for base-analysis job locks.
# Local: omit to use in-memory KV (process-local; fine for `pnpm dev`).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Or Vercel KV aliases:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Inngest — Phase-4 delivery hops + companion 30-day fill/drip (required for production).
# Setup: docs/inngest-setup.md — App sync URL https://<domain>/api/inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Prefer Inngest for Phase-4 continue/task when EVENT_KEY is set (default). Set 0 to fall back.
# DELIVERY_CONTINUE_VIA_INNGEST=1

# Upstash QStash — optional fallback for Phase-4 hops when Inngest is not configured.
# Self-fetch /continue→/continue is blocked by Vercel HTTP 508 (INFINITE_LOOP_DETECTED).
# Console: https://console.upstash.com/qstash → QSTASH_TOKEN
QSTASH_TOKEN=
# Force QStash even off Vercel (1) or force direct self-fetch (0). Default: on when VERCEL=1 and no Inngest.
# DELIVERY_CONTINUE_VIA_QSTASH=1

# Ops console (/ops) ? internal only; never commit real values
OPS_USER=
OPS_PASSWORD=
OPS_SESSION_SECRET=

# Public site URL (Stripe success/cancel + OAuth redirectTo)
# Local Google login: http://localhost:3000
# Production (Vercel): https://easternos.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Auth (email OTP / password / Google OAuth via Supabase Providers)
# Google Client ID/Secret go in Supabase Dashboard ? Auth ? Providers ? Google
# Do NOT put GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET here (not NextAuth).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Middleware auth guard for /app and /poju/session/* (default on when Supabase is configured).
# Set to 0 to allow anonymous workspace access (Never Required · recommended for local).
# Without this, a stale browser session can bounce login ↔ /app forever.
AUTH_ROUTE_GUARD=0

# Resend API (app-sent mail: decision reports, Companion reminders)
# Auth OTP is sent by Supabase via Custom SMTP → Resend (see docs/email-resend-from-addresses.md)
RESEND_API_KEY=
# Role From addresses (all @mail.easternos.com). Do not use noreply@ for these three.
RESEND_FROM_VERIFY=Eastern OS Validation <verify@mail.easternos.com>
RESEND_FROM_REPORTS=Eastern OS Reports <reports@mail.easternos.com>
RESEND_FROM_NOTIFY=Eastern OS <notify@mail.easternos.com>
# Deprecated — prefer the three role From vars above (ignored when they are set)
# RESEND_FROM_EMAIL=

# Stripe Checkout + webhook (Pass purchase / subscriptions)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Pass consumption gate (comma list or all/off). Default: all five products.
# PASS_ENFORCE_PRODUCTS=all
# PASS_ENFORCE_PRODUCTS=pivot
# PASS_ENFORCE_PRODUCTS=atmos,pivot,match,syncro,glyph
# PASS_ENFORCE_PRODUCTS=off

# Creem MoR (Path A refunds: POST /v1/refunds { transaction_id })
# CREEM_API_KEY=
# CREEM_API_BASE=https://api.creem.io

