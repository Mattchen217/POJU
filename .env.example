# Copy to `.env.local` and fill in secrets. Do not commit `.env.local`.

GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_API_KEY=
GOOGLE_GENERATIVE_AI_MODEL=gemini-3.1-flash-lite-preview

# POJU v5 â€” OpenRouter (DeepSeek V4 Pro via OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-pro

# Provider order â€” StreamLake only (production). SiliconFlow disabled until Reasoning JSON truncation is fixed.
OPENROUTER_PROVIDER_ORDER=streamlake

# Ops console (/ops) ¡ª internal only; never commit real values
OPS_USER=
OPS_PASSWORD=
OPS_SESSION_SECRET=
