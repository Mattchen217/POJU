# Copy to `.env.local` and fill in secrets. Do not commit `.env.local`.

# UI shell: workspace (V2 landing + app, default) | classic (legacy marketing home).
# Override at runtime with ?ui=workspace|classic or localStorage poju.uiShell.
NEXT_PUBLIC_UI_SHELL=workspace

GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_API_KEY=
GOOGLE_GENERATIVE_AI_MODEL=gemini-3.1-flash-lite-preview

# POJU v5 ù OpenRouter (DeepSeek V4 Pro via OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-pro

# Provider order ù StreamLake only (production). SiliconFlow disabled until Reasoning JSON truncation is fixed.
OPENROUTER_PROVIDER_ORDER=streamlake

# Upstash / Vercel KV ù required on Vercel for base-analysis job locks.
# Local: omit to use in-memory KV (process-local; fine for `pnpm dev`).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Or Vercel KV aliases:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Ops console (/ops) ù internal only; never commit real values
OPS_USER=
OPS_PASSWORD=
OPS_SESSION_SECRET=

# Public site URL (Stripe success/cancel redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Auth (email OTP). Configure Custom SMTP ? Resend in Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (also used by /api/email/send; Supabase Custom SMTP uses Resend SMTP creds)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@your-domain.com

# Stripe Checkout + webhook (Pass purchase / subscriptions)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
