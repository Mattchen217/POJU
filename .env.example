# Copy to `.env.local` and fill in secrets. Do not commit `.env.local`.

GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_API_KEY=
GOOGLE_GENERATIVE_AI_MODEL=gemini-3.1-flash-lite-preview

# POJU v5 — OpenRouter (DeepSeek V4 Pro via OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-pro

# Provider order — base slug only (no /fp8 suffix). Must match Vercel Production/Preview exactly.
# Single supplier: code sets allow_fallbacks:false — if baidu is down, request fails (no drift).
OPENROUTER_PROVIDER_ORDER=streamlake,siliconflow,deepinfra
