# Copy to `.env.local` and fill in secrets. Do not commit `.env.local`.

GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_API_KEY=
GOOGLE_GENERATIVE_AI_MODEL=gemini-3.1-flash-lite-preview

# POJU v5 — OpenRouter (DeepSeek V4 Pro via OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-pro

# Provider order — comma-separated OpenRouter endpoint tags (no spaces).
# Must match Vercel Production/Preview exactly. Code sets allow_fallbacks:false (only these three; no drift).
# Slugs from https://openrouter.ai/deepseek/deepseek-v4-pro/providers
OPENROUTER_PROVIDER_ORDER=baidu/fp8,streamlake,siliconflow/fp8
