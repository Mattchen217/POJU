# Copy to `.env.local` and fill in secrets. Do not commit `.env.local`.

# UI shell: classic (current marketing) | workspace (left-sidebar app). Default classic.
# Override at runtime with ?ui=workspace|classic or localStorage poju.uiShell.
NEXT_PUBLIC_UI_SHELL=classic

GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_API_KEY=
GOOGLE_GENERATIVE_AI_MODEL=gemini-3.1-flash-lite-preview

# POJU v5 — OpenRouter (DeepSeek V4 Pro via OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-pro

# Provider order — StreamLake only (production). SiliconFlow disabled until Reasoning JSON truncation is fixed.
OPENROUTER_PROVIDER_ORDER=streamlake

# Upstash / Vercel KV — required on Vercel for base-analysis job locks.
# Local: omit to use in-memory KV (process-local; fine for `pnpm dev`).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Or Vercel KV aliases:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Ops console (/ops) — internal only; never commit real values
OPS_USER=
OPS_PASSWORD=
OPS_SESSION_SECRET=
