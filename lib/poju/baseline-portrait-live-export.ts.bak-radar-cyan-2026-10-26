function sleep(ms: number): Promise<void> {
  return new Promise((r) => setTimeout(r, ms));
}

async function waitFrames(n = 2): Promise<void> {
  for (let i = 0; i < n; i++) {
    await new Promise<void>((r) => requestAnimationFrame(() => r()));
  }
}

function wrapIntl(
  locale: string,
  messages: AbstractIntlMessages,
  child: ReactElement,
): ReactElement {
  // next-intl types require `children` on props (not only as createElement’s 3rd arg).
  return createElement(NextIntlClientProvider, {
    locale,
    messages,
    children: child,
  });
}

async function renderAndSettle(root: Root, node: ReactElement): Promise<void> {
  root.render(node);
  await waitFrames(3);
  await sleep(80);
}

/**
 * Wait until a pane mount has real matrix body (not empty / logo-only stub).
 * PojuEnergyMatrix bodyOnly paints `.pcm` sections per block.
 */
async function waitForPaneReady(
  host: HTMLElement,
  blockId: string,
  timeoutMs = 4000,
): Promise<HTMLElement> {
  const started = Date.now();
  while (Date.now() - started < timeoutMs) {
    const mount = host.querySelector(
      ".baseline-live-export-pane-mount",
    ) as HTMLElement | null;
    if (mount) {
      const pcm = mount.querySelector(".pcm");
      const section = mount.querySelector(
        ".pcm__section, .pcm-shell__panel, .pcm-calibration, .pcm-energy, .pcm-pillars, .pcm-facts-extra",
      );
      const textLen = (mount.textContent || "").replace(/\s+/g, " ").trim().length;
      if (pcm && section && textLen > 40) {
        await waitFrames(2);
        return mount;
      }
    }
    await sleep(50);
    await waitFrames(1);
  }
  throw new Error(
    `live export: pane not ready for block ${blockId} (no painted .pcm body)`,
  );
}

/**
 * Wait until BaselinePortraitBook shell has TOC + right page body (full book chrome).
 */
async function waitForBookShellReady(
  host: HTMLElement,
  timeoutMs = 4000,
): Promise<HTMLElement> {
  const started = Date.now();
  while (Date.now() - started < timeoutMs) {
    const stage = host.querySelector(".delivery-book-stage") as HTMLElement | null;
    if (stage) {
      const tocItems = stage.querySelectorAll(".delivery-book-stage__toc-item");
      const slots =
        stage.querySelector(".baseline-portrait-book__page") ||
        stage.querySelector(".delivery-book-stage__page-slots");
      const pcm = stage.querySelector(".pcm");
      const pager = stage.querySelector(".delivery-book-stage__pager-pos");
      if (
        tocItems.length >= BASELINE_MATRIX_BLOCKS.length &&
        slots &&
        pcm &&
        pager
      ) {
        await waitFrames(2);
        return stage;
      }
    }
    await sleep(50);
    await waitFrames(1);
  }
  throw new Error(
    "live export: BaselinePortraitBook shell not fully ready (TOC/pcm/pager)",
  );
}


/**
 * B2 Wuxing radar is ECharts canvas (renderer: "canvas"). innerHTML/outerHTML
 * never carries pixels — and dynamic import often finishes AFTER waitForPaneReady
 * (text-only readiness). Wait for a painted canvas, then swap to inline PNG <img>.
 */
async function waitForRadarCanvasReady(
  host: HTMLElement,
  blockId: string,
  timeoutMs = 8000,
): Promise<void> {
  if (blockId !== "energy") return;
  const started = Date.now();
  while (Date.now() - started < timeoutMs) {
    const wrap = host.querySelector(".pcm-radar__canvas") as HTMLElement | null;
    const canvas = wrap?.querySelector("canvas") as HTMLCanvasElement | null;
    if (canvas && canvas.width > 8 && canvas.height > 8) {
      await waitFrames(3);
      await sleep(120);
      let painted = false;
      try {
        const ctx = canvas.getContext("2d");
        if (ctx) {
          const { data } = ctx.getImageData(0, 0, canvas.width, canvas.height);
          for (let i = 3; i < data.length; i += 32) {
            if (data[i] > 0) {
              painted = true;
              break;
            }
          }
        }
      } catch {
        // Cross-origin / protected canvas — still attempt toDataURL later.
        painted = true;
      }
      if (painted) return;
    }
    await sleep(50);
    await waitFrames(1);
  }
  throw new Error(
    `live export: Wuxing radar canvas not painted for block ${blockId}`,
  );
}

/**
 * Replace every ECharts (or other) <canvas> under root with an inline PNG <img>
 * so file:// serialize keeps the visual. Prefer replacing the whole .pcm-radar__canvas
 * host contents (ECharts may leave helper canvases/divs).
 */
function snapshotCanvasesToImages(rootEl: HTMLElement): void {
  const radarHosts = Array.from(
    rootEl.querySelectorAll<HTMLElement>(".pcm-radar__canvas"),
  );
  for (const host of radarHosts) {
    const canvas = host.querySelector("canvas") as HTMLCanvasElement | null;
    if (!canvas) continue;
    let dataUrl = "";
    try {
      dataUrl = canvas.toDataURL("image/png");
    } catch {
      continue;
    }
    if (!dataUrl || dataUrl.length < 64) continue;
    const img = document.createElement("img");
    img.src = dataUrl;
    img.alt = "";
    img.setAttribute("aria-hidden", "true");
    img.className = "pcm-radar__snapshot";
    img.style.width = "100%";
    img.style.height = "100%";
    img.style.display = "block";
    img.style.objectFit = "contain";
    host.innerHTML = "";
    host.appendChild(img);
  }

  // Any remaining non-radar canvases (e.g. timeline) — swap in place.
  const leftover = Array.from(rootEl.querySelectorAll("canvas"));
  for (const canvas of leftover) {
    let dataUrl = "";
    try {
      dataUrl = canvas.toDataURL("image/png");
    } catch {
      continue;
    }
    if (!dataUrl || dataUrl.length < 64) continue;
    const img = document.createElement("img");
    img.src = dataUrl;
    img.alt = "";
    img.setAttribute("aria-hidden", "true");
    const w = canvas.style.width || (canvas.width ? `${canvas.width}px` : "100%");
    const h = canvas.style.height || (canvas.height ? `${canvas.height}px` : "100%");
    img.style.cssText = `width:${w};height:${h};display:block;max-width:100%;object-fit:contain;`;
    canvas.replaceWith(img);
  }
}

function baselinePortraitLiveFilename(d = new Date()): string {
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, "0");
  const day = String(d.getDate()).padStart(2, "0");
  return `eastern-os-baseline-profile-live-${y}-${m}-${day}.html`;
}

/** Collect same-origin stylesheet rules that style the book / matrix. */
export function collectLiveBookCssFromDocument(): string {
  const chunks: string[] = [];
  const re =
    /delivery-book-stage|\.pcm\b|pcm--|workspace-scroll|material-symbols|poju-logo|baseline-portrait/i;
  for (const sheet of Array.from(document.styleSheets)) {
    let rules: CSSRuleList;
    try {
      rules = sheet.cssRules;
    } catch {
      continue;
    }
    for (const rule of Array.from(rules)) {
      const text = rule.cssText;
      // Drop broken empty declarations from browser cssText expansion
      if (/:\s*;/.test(text)) continue;
      if (re.test(text)) chunks.push(text);
    }
  }
  return chunks.join("\n");
}

async function blobToDataUrl(blob: Blob): Promise<string> {
  return new Promise((resolve, reject) => {
    const fr = new FileReader();
    fr.onload = () => resolve(String(fr.result));
    fr.onerror = () => reject(fr.error);
    fr.readAsDataURL(blob);
  });
}

async function fetchAsDataUrl(href: string): Promise<string | null> {
  try {
    const url = new URL(href, window.location.href);
    // Same-origin preferred; also allow inlining fonts.gstatic when present in live CSS
    // so offline pack does not keep a network font URL.
    const res = await fetch(url.toString());
    if (!res.ok) return null;
    return await blobToDataUrl(await res.blob());
  } catch {
    return null;
  }
}

/**
 * Inline <img src> and CSS mask-image urls (DeliveryChromeIconBtn uses mask, not <img>).
 * Page-turn prev/next would otherwise be empty offline (url("/v2/shangicon.svg")).
 */
async function inlineSameOriginAssets(rootEl: HTMLElement): Promise<void> {
  const imgs = Array.from(rootEl.querySelectorAll("img"));
  await Promise.all(
    imgs.map(async (img) => {
      const src = img.currentSrc || img.getAttribute("src") || "";
      if (!src || src.startsWith("data:")) return;
      try {
        const url = new URL(src, window.location.origin);
        if (url.origin !== window.location.origin) return;
        const dataUrl = await fetchAsDataUrl(url.toString());
        if (!dataUrl) return;
        img.setAttribute("src", dataUrl);
        img.removeAttribute("srcset");
      } catch {
        /* keep original src */
      }
    }),
  );

  const maskEls = Array.from(
    rootEl.querySelectorAll<HTMLElement>(".delivery-book-stage__icon-glyph, [style*='mask-image'], [style*='maskImage']"),
  );
  await Promise.all(
    maskEls.map(async (el) => {
      const styleAttr = el.getAttribute("style") || "";
      const computedMask =
        el.style.getPropertyValue("mask-image") ||
        el.style.getPropertyValue("-webkit-mask-image") ||
        "";
      const fromAttr = /(?:-webkit-)?mask-image\s*:\s*url\(\s*(['"]?)([^)'"]+)\1\s*\)/i.exec(
        styleAttr,
      );
      const rawUrl =
        (fromAttr && fromAttr[2]) ||
        (/url\(\s*(['"]?)([^)'"]+)\1\s*\)/i.exec(computedMask || "") ||
          [])[2] ||
        "";
      if (!rawUrl || rawUrl.startsWith("data:")) return;
      const dataUrl = await fetchAsDataUrl(rawUrl);
      if (!dataUrl) return;
      el.style.setProperty("mask-image", `url("${dataUrl}")`);
      el.style.setProperty("-webkit-mask-image", `url("${dataUrl}")`);
      // Keep attribute in sync for serialize (clone.outerHTML reads attribute in some paths)
      const cleaned = styleAttr
        .replace(/(?:-webkit-)?mask-image\s*:\s*url\(\s*(['"]?)([^)'"]+)\1\s*\)\s*;?/gi, "")
        .trim()
        .replace(/;\s*;/g, ";");
      const next = `${cleaned}${cleaned && !cleaned.endsWith(";") ? ";" : ""}mask-image: url("${dataUrl}"); -webkit-mask-image: url("${dataUrl}");`;
      el.setAttribute("style", next.replace(/^;/, ""));
    }),
  );
}

/** Known pager icon paths — inject if serialize still has empty glyphs. */
const OFFLINE_PAGER_ICON_PATHS = {
  prev: "/v2/shangicon.svg",
  next: "/v2/xiaicon.svg",
} as const;

async function ensurePagerIconMasks(rootEl: HTMLElement): Promise<void> {
  const pager = rootEl.querySelector(".delivery-book-stage__pager");
  if (!pager) return;
  const buttons = Array.from(pager.querySelectorAll("button"));
  const prevBtn = buttons[0];
  const nextBtn = buttons[1];
  const pairs: Array<[Element | undefined, string]> = [
    [prevBtn, OFFLINE_PAGER_ICON_PATHS.prev],
    [nextBtn, OFFLINE_PAGER_ICON_PATHS.next],
  ];
  for (const [btn, path] of pairs) {
    if (!btn) continue;
    let glyph = btn.querySelector<HTMLElement>(".delivery-book-stage__icon-glyph");
    if (!glyph) {
      glyph = document.createElement("span");
      glyph.className = "delivery-book-stage__icon-glyph";
      glyph.setAttribute("aria-hidden", "true");
      btn.appendChild(glyph);
    }
    const styleAttr = glyph.getAttribute("style") || "";
    if (styleAttr.includes("data:") || (glyph.style.maskImage || "").includes("data:")) {
      continue;
    }
    const dataUrl = await fetchAsDataUrl(path);
    if (!dataUrl) continue;
    glyph.style.setProperty("mask-image", `url("${dataUrl}")`);
    glyph.style.setProperty("-webkit-mask-image", `url("${dataUrl}")`);
    glyph.setAttribute(
      "style",
      `mask-image: url("${dataUrl}"); -webkit-mask-image: url("${dataUrl}");`,
    );
  }
}

/**
 * Collect @font-face from the live document and rewrite src urls to data: so file://
 * needs no CDN. Covers next/font (Inter/Geist/Noto) + Material Symbols when loaded.
 */
async function collectInlinedFontFacesCss(): Promise<string> {
  const out: string[] = [];
  const seen = new Set<string>();

  const rewriteSrc = async (cssText: string): Promise<string> => {
    const re = /url\(\s*(['"]?)([^)'"]+)\1\s*\)/g;
    let result = cssText;
    const matches = Array.from(cssText.matchAll(re));
    for (const m of matches) {
      const href = m[2];
      if (!href || href.startsWith("data:")) continue;
      const dataUrl = await fetchAsDataUrl(href);
      if (!dataUrl) continue;
      result = result.split(m[0]).join(`url("${dataUrl}")`);
    }
    return result;
  };

  for (const sheet of Array.from(document.styleSheets)) {
    let rules: CSSRuleList;
    try {
      rules = sheet.cssRules;
    } catch {
      continue;
    }
    for (const rule of Array.from(rules)) {
      if (rule instanceof CSSFontFaceRule) {
        const key = rule.cssText.slice(0, 120);
        if (seen.has(key)) continue;
        seen.add(key);
        out.push(await rewriteSrc(rule.cssText));
      }
    }
  }

  // Guaranteed Material Symbols offline face from same-origin public/fonts (no Google link).
  const localMs = await fetchAsDataUrl("/fonts/material-symbols-outlined.woff2");
  if (localMs) {
    out.push(`@font-face{
  font-family:'Material Symbols Outlined';
  font-style:normal;
  font-weight:400;
  font-display:block;
  src:url("${localMs}") format('woff2');
}`);
  }

  out.push(`.material-symbols-outlined{
  font-family:'Material Symbols Outlined';
  font-weight:normal;
  font-style:normal;
  font-size:24px;
  line-height:1;
  letter-spacing:normal;
  text-transform:none;
  display:inline-block;
  white-space:nowrap;
  word-wrap:normal;
  direction:ltr;
  -webkit-font-feature-settings:'liga';
  -webkit-font-smoothing:antialiased;
  font-variation-settings:'FILL' 0,'wght' 400,'GRAD' 0,'opsz' 24;
}`);

  return out.join("\n");
}

/**
 * PojuLogo / next/image emit width/height + Tailwind h-[Npx] classes.
 * Offline pack does not include Tailwind → intrinsic 711×711 / 1134×198 logos
 * explode into a blurry splash and crush the book chrome. Force sizes inline.
 */
function normalizeOfflineImages(rootEl: HTMLElement): void {
  rootEl
    .querySelectorAll<HTMLImageElement>(
      ".delivery-book-stage__header-logo-link img, a.delivery-book-stage__header-logo-link img",
    )
    .forEach((img) => {
      img.removeAttribute("width");
      img.removeAttribute("height");
      img.style.height = "18px";
      img.style.width = "auto";
      img.style.maxHeight = "22px";
      img.style.objectFit = "contain";
      img.style.display = "block";
    });

  rootEl.querySelectorAll<HTMLImageElement>("img[data-nimg]").forEach((img) => {
    // Already handled header logos above; clamp any other next/image without pcm CSS.
    if (img.closest(".delivery-book-stage__header-logo-link")) return;
    if (img.classList.contains("pcm-zodiac__art-img")) return;
    const cls = img.getAttribute("class") || "";
    if (/h-\[(\d+)px\]/.test(cls)) {
      const h = RegExp.$1;
      img.style.height = `${h}px`;
      img.style.width = "auto";
      img.style.objectFit = "contain";
      img.removeAttribute("width");
      img.removeAttribute("height");
    }
  });
}

function stripReactNoise(html: string): string {
  return html
    .replace(/\s+data-reactroot(?:="")?/g, "")
    .replace(/\s+style=""/g, "");
}

function buildPagerScript(pageCount: number): string {
  return `(function(){
  var root=document.querySelector('[data-baseline-live-export="1"]');
  if(!root) return;
  var panes=Array.prototype.slice.call(root.querySelectorAll('[data-export-page]'));
  var tocBtns=Array.prototype.slice.call(root.querySelectorAll('[data-export-toc]'));
  var prev=root.querySelector('[data-export-prev]');
  var next=root.querySelector('[data-export-next]');
  var pos=root.querySelector('[data-export-pos]');
  var i=0;
  var n=${pageCount};
  function show(idx){
    i=Math.max(0,Math.min(n-1,idx));
    panes.forEach(function(p,k){ if(k===i) p.removeAttribute('hidden'); else p.setAttribute('hidden',''); });
    tocBtns.forEach(function(b,k){
      var on=k===i;
      b.classList.toggle('delivery-book-stage__toc-item--active', on);
      b.classList.toggle('delivery-book-stage__toc-item--ready', !on);
      if(on) b.setAttribute('aria-current','page'); else b.removeAttribute('aria-current');
    });
    var titleEl=root.querySelector('.delivery-book-stage__page-title');
    var tocTitle=tocBtns[i] && tocBtns[i].querySelector('.delivery-book-stage__toc-title');
    if(titleEl && tocTitle) titleEl.textContent=tocTitle.textContent || titleEl.textContent;
    if(pos) pos.textContent=(i+1)+' / '+n;
    if(prev) prev.disabled=i<=0;
    if(next) next.disabled=i>=n-1;
    var vp=root.querySelector('.delivery-book-stage__right-scroll .workspace-scroll__viewport, .delivery-book-stage__right-scroll');
    if(vp) vp.scrollTop=0;
  }
  tocBtns.forEach(function(b,k){ b.addEventListener('click', function(){ show(k); }); });
  if(prev) prev.addEventListener('click', function(){ show(i-1); });
  if(next) next.addEventListener('click', function(){ show(i+1); });
  show(0);
})();`;
}

